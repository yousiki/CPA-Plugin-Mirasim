diff --git c/src/features/quota/providers/mirasim/MirasimQuotaBody.tsx i/src/features/quota/providers/mirasim/MirasimQuotaBody.tsx
new file mode 100644
index 0000000..71c62ab
--- /dev/null
+++ i/src/features/quota/providers/mirasim/MirasimQuotaBody.tsx
@@ -0,0 +1,77 @@
+/**
+ * Mirasim 额度渲染体：unified rate-limit 窗口水位条 + 累计消耗。
+ *
+ * 与 Kimi 同构（rows + 水位条），差别有二：
+ *  - 网关只报「已用比例」，所以水位条画的是剩余量 100 - used，与其余提供商口径一致；
+ *  - 网关只在有数据时才下发某个窗口的头，缺失的窗口直接不渲染，而不是画一条空轨道。
+ */
+
+import { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { MirasimQuotaState } from '@/types';
+import { buildResetDisplay } from '@/utils/quota';
+import { useNow } from '@/hooks/useNow';
+import { QuotaMeter } from '../../components/QuotaMeter';
+import { QuotaResetLabel } from '../../components/QuotaResetLabel';
+import { collectQuotaRowInstants, pickUrgentRowId } from '../../resetSchedule';
+import type { QuotaBodyProps } from '../../types';
+
+export function MirasimQuotaBody({ quota, classes }: QuotaBodyProps<MirasimQuotaState>) {
+  const { t, i18n } = useTranslation();
+  // 早退之前 —— hooks 不能条件调用。
+  const now = useNow();
+  const soonestRowId = useMemo(
+    () => pickUrgentRowId(collectQuotaRowInstants('mirasim', quota), now),
+    [quota, now]
+  );
+  const rows = quota.rows ?? [];
+  const spend = quota.spend;
+
+  if (rows.length === 0) {
+    return <div className={classes.quotaMessage}>{t('mirasim_quota.empty_data')}</div>;
+  }
+
+  return (
+    <>
+      {rows.map((row, index) => {
+        const remaining = Math.max(0, Math.min(100, 100 - row.used));
+        const rowLabel = row.labelKey
+          ? t(row.labelKey, (row.labelParams ?? {}) as Record<string, string | number>)
+          : (row.label ?? '');
+        const resetDisplay = buildResetDisplay(null, row.resetAtMs, now, i18n.resolvedLanguage);
+        const soon = row.id === soonestRowId;
+
+        return (
+          <div
+            key={row.id}
+            className={classes.quotaRow}
+            title={soon ? t('quota_management.soonest_row_hint') : undefined}
+          >
+            <div className={classes.quotaRowHeader}>
+              <span className={classes.quotaModel}>{rowLabel}</span>
+              <div className={classes.quotaMeta}>
+                <span className={classes.quotaPercent}>{`${Math.round(remaining)}%`}</span>
+                {resetDisplay && (
+                  <QuotaResetLabel display={resetDisplay} classes={classes} soon={soon} />
+                )}
+              </div>
+            </div>
+            <QuotaMeter percent={remaining} classes={classes} index={index} />
+          </div>
+        );
+      })}
+
+      {typeof spend === 'number' && spend >= 0 && (
+        <div className={classes.codexPlan}>
+          <div className={classes.codexPlanItem}>
+            <span className={classes.codexPlanLabel}>{t('mirasim_quota.spend')}</span>
+            {/* 网关不带单位，原样显示而不是伪装成货币 */}
+            <span className={classes.codexPlanValue}>
+              {spend.toLocaleString(undefined, { maximumFractionDigits: 2 })}
+            </span>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
diff --git c/src/features/quota/providers/mirasim/data.ts i/src/features/quota/providers/mirasim/data.ts
new file mode 100644
index 0000000..b393ad4
--- /dev/null
+++ i/src/features/quota/providers/mirasim/data.ts
@@ -0,0 +1,116 @@
+/**
+ * Mirasim 额度数据层。React-free / SCSS-free。
+ *
+ * 与其他五个提供商不同：Mirasim relay 没有用量接口，用量只出现在 Anthropic 的
+ * unified rate-limit 响应头里。读取这些头需要一次真实请求，因此由 mirasim 插件
+ * 在服务端完成（探测 + 缓存），面板只读插件自己的管理路由，不走 api-call。
+ */
+
+import type { TFunction } from 'i18next';
+import type { AuthFileItem, MirasimQuotaRow, MirasimQuotaState } from '@/types';
+import { apiClient } from '@/services/api/client';
+import { createStatusError, isDisabledAuthFile, isMirasimFile } from '@/utils/quota';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import type { QuotaProviderData } from '../types';
+
+/** 插件返回的一次读数；utilization 为百分比，-1 表示该头缺失。 */
+interface MirasimQuotaPayload {
+  ok?: boolean;
+  error?: string;
+  quota?: {
+    status?: number;
+    utilization_5h?: number;
+    utilization_7d?: number;
+    reset_5h?: number;
+    reset_7d?: number;
+    key_spend?: number;
+    at?: number;
+    error?: string;
+  } | null;
+}
+
+export interface MirasimQuotaData {
+  rows: MirasimQuotaRow[];
+  spend: number | null;
+  readAt: number | null;
+}
+
+const hasValue = (value: number | undefined): value is number =>
+  typeof value === 'number' && value >= 0;
+
+/** 秒级 epoch → 毫秒；0/缺失视为「没有重置时间」。 */
+const toResetMs = (seconds: number | undefined): number | null =>
+  typeof seconds === 'number' && seconds > 0 ? seconds * 1000 : null;
+
+const fetchMirasimQuota = async (file: AuthFileItem, t: TFunction): Promise<MirasimQuotaData> => {
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) {
+    throw new Error(t('mirasim_quota.missing_auth_index'));
+  }
+
+  const payload = await apiClient.get<MirasimQuotaPayload>('/mirasim/quota', {
+    params: { auth_index: authIndex },
+  });
+
+  if (!payload || payload.ok !== true) {
+    throw new Error(payload?.error || t('mirasim_quota.empty_data'));
+  }
+  const quota = payload.quota;
+  if (!quota) {
+    throw new Error(t('mirasim_quota.probe_disabled'));
+  }
+  // 凭证被 relay 拒绝时插件会带上 error：这时报错比画一条 0% 的水位条诚实。
+  if (quota.error && !hasValue(quota.utilization_5h) && !hasValue(quota.utilization_7d)) {
+    throw createStatusError(quota.error, quota.status);
+  }
+
+  const rows: MirasimQuotaRow[] = [];
+  if (hasValue(quota.utilization_5h)) {
+    rows.push({
+      id: 'mirasim-5h',
+      labelKey: 'mirasim_quota.window_5h',
+      used: quota.utilization_5h,
+      limit: 100,
+      resetAtMs: toResetMs(quota.reset_5h),
+      periodHours: 5,
+    });
+  }
+  if (hasValue(quota.utilization_7d)) {
+    rows.push({
+      id: 'mirasim-7d',
+      labelKey: 'mirasim_quota.window_7d',
+      used: quota.utilization_7d,
+      limit: 100,
+      resetAtMs: toResetMs(quota.reset_7d),
+      periodHours: 168,
+    });
+  }
+
+  return {
+    rows,
+    spend: hasValue(quota.key_spend) ? quota.key_spend : null,
+    readAt: quota.at ?? null,
+  };
+};
+
+export const MIRASIM_CONFIG: QuotaProviderData<MirasimQuotaState, MirasimQuotaData> = {
+  type: 'mirasim',
+  i18nPrefix: 'mirasim_quota',
+  filterFn: (file) => isMirasimFile(file) && !isDisabledAuthFile(file),
+  fetchQuota: fetchMirasimQuota,
+  storeSelector: (state) => state.mirasimQuota,
+  storeSetter: 'setMirasimQuota',
+  buildLoadingState: () => ({ status: 'loading', rows: [] }),
+  buildSuccessState: (data) => ({
+    status: 'success',
+    rows: data.rows,
+    spend: data.spend,
+    readAt: data.readAt,
+  }),
+  buildErrorState: (message, status) => ({
+    status: 'error',
+    rows: [],
+    error: message,
+    errorStatus: status,
+  }),
+};
