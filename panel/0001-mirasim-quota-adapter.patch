+// Mirasim (plugin provider) quota types
+//
+// The Mirasim relay has no usage endpoint: it reports usage through Anthropic's unified
+// rate-limit headers, which the mirasim CPA plugin reads and exposes on its own
+// management route. A row is therefore one window's utilization percentage, with
+// `limit` fixed at 100 so the meter maths stays identical to the other providers.
+export interface MirasimQuotaRow {
+  id: string;
+  label?: string;
+  labelKey?: string;
+  labelParams?: Record<string, string | number>;
+  used: number;
+  limit: number;
+  /** Reset instant in epoch ms; null when the gateway sent no reset header. */
+  resetAtMs?: number | null;
+  periodHours?: number | null;
+}
+
+export interface MirasimQuotaState {
+  status: 'idle' | 'loading' | 'success' | 'error';
+  rows: MirasimQuotaRow[];
+  /** x-litellm-key-spend, reported by the gateway without a unit; null when absent. */
+  spend?: number | null;
+  /** Epoch seconds of the reading, so the card can show how stale it is. */
+  readAt?: number | null;
+  error?: string;
+  errorStatus?: number;
+}
+
 // xAI/Grok API payload types
 export interface XaiBillingCent {
   val?: number | string;
